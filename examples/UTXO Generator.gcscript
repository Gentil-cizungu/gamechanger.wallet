{
  "title": "UTXO Generator",
  "description": "Sends 'utxo-quantity' lovelace back to your current address, creating one new UTXO. Run it several times to get more UTXOs and improve multi-transaction concurrency for dapps and GCFS filesystem write events. Returns the transaction hash",
  "type": "script",
  "exportAs": "data",
  "return": {
    "mode": "last"
  },
  "args": {
    "utxo-quantity": "1000000"
  },
  "isolateCache": true,
  "run": {
    "argumentGuards": {
      "type": "macro",
      "run": "{assert(cmpBigNum('gte',get('args.utxo-quantity'),'1000000'),'utxo-quantity must be at least 1000000 lovelace')}"
    },
    "address": {
      "type": "getCurrentAddress"
    },
    "build": {
      "type": "buildTx",
      "title": "UTXO Generator",
      "name": "UTXO Generator",
      "description": "Sends lovelace back to your own address as a new UTXO",
      "tx": {
        "outputs": [
          {
            "address": "{get('cache.address')}",
            "assets": [
              {
                "assetName": "ada",
                "policyId": "ada",
                "quantity": "{get('args.utxo-quantity')}"
              }
            ]
          }
        ],
        "options": {
          "coinSelection": "FMR",
          "changeOptimizer": "BAL",
          "autoProvision": {
            "workspaceNativeScript": true
          },
          "autoOptionalSigners": {
            "nativeScript": true
          }
        }
      }
    },
    "sign": {
      "type": "signTxs",
      "namePattern": "UTXO Generator Signed",
      "detailedPermissions": false,
      "txs": [
        "{get('cache.build.txHex')}"
      ]
    },
    "submit": {
      "type": "submitTxs",
      "mode": "parallel",
      "namePattern": "UTXO Generator Submitted",
      "txs": "{get('cache.sign')}"
    },
    "finally": {
      "type": "macro",
      "run": "{get('cache.build.txHash')}"
    }
  }
}